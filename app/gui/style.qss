/* MaratronVR — Steam Big Picture / Steam Input inspired shell */
/* Colors synced with docs/design-token.json */

/* --- ROOT --- */
QWidget {
    background-color: #0A0E14;
    color: #F2F4F8;
    font-family: "Segoe UI", "Noto Sans", "Ubuntu", sans-serif;
    font-size: 14px;
    font-weight: 400;
}

QLabel {
    background: transparent;
    color: #F2F4F8;
    font-weight: 400;
}

QLabel#app_title {
    color: #F2F4F8;
    font-size: 16px;
    font-weight: 700;
}

/* --- HEADER --- */
QFrame#steam_header {
    background-color: #0A0E14;
    border-bottom: 1px solid #232B38;
}

QLabel#nav_keycap {
    color: #1A212C;
    background-color: #F2F4F8;
    border: 1px solid #9AA4B2;
    border-radius: 4px;
    min-width: 24px;
    max-width: 24px;
    min-height: 22px;
    max-height: 22px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#session_status_pill {
    background-color: #5C6675;
    border: 1px solid #5C6675;
    border-radius: 5px;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
    padding: 0;
}

QLabel#session_status_pill[status="active"] {
    background-color: #3B82F6;
    border-color: #3B82F6;
}

QLabel#session_status_pill[status="inactive"] {
    background-color: #5C6675;
    border-color: #5C6675;
}

QLabel#profile_avatar {
    color: #F2F4F8;
    background-color: #1A212C;
    border: 1px solid #232B38;
    border-right: 3px solid #3B82F6;
    border-radius: 0;
    font-size: 15px;
    font-weight: 700;
}

QLabel#header_clock {
    color: #F2F4F8;
    font-size: 16px;
    font-weight: 700;
    padding-left: 14px;
}

/* --- FOOTER --- */
QFrame#steam_footer {
    background-color: #0A0E14;
    border-top: 1px solid #232B38;
    min-height: 38px;
    max-height: 42px;
}

QFrame#footer_shortcut_hint,
QFrame#footer_shortcut_button {
    background-color: transparent;
    border: 0;
    border-radius: 14px;
    padding: 2px 4px;
}

QFrame#footer_shortcut_button:hover,
QFrame#footer_shortcut_button:focus {
    background-color: rgba(255, 255, 255, 0.08);
}

QFrame#footer_shortcut_button:pressed {
    background-color: rgba(255, 255, 255, 0.14);
}

QLabel#footer_keycap {
    color: #0A0E14;
    background-color: #F2F4F8;
    border: 1px solid #9AA4B2;
    border-radius: 12px;
    min-width: 25px;
    max-width: 88px;
    min-height: 25px;
    max-height: 25px;
    padding: 0 7px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#footer_action_label {
    color: #F2F4F8;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

/* --- CARDS --- */
QFrame#command_card,
QFrame#hero_card {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-radius: 8px;
}

QFrame#stat_tile {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-radius: 6px;
    min-height: 50px;
}

QFrame#stat_tile:hover {
    background-color: #161C26;
    border-color: #3B82F6;
}

QFrame#stat_tile QLabel {
    color: #F2F4F8;
    font-size: 15px;
    font-weight: 400;
}

/* --- TYPOGRAPHY --- */
QLabel#card_title {
    color: #F2F4F8;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
}

QLabel#card_subtitle {
    color: #9AA4B2;
    font-size: 14px;
    font-weight: 400;
}

QLabel#section_title {
    color: #F2F4F8;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.9px;
}

QLabel#small_caps {
    color: #9AA4B2;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
}

QLabel#sensitivity_label {
    color: #F2F4F8;
    font-size: 13px;
    font-weight: 500;
}

/* --- SCROLL AREA --- */
QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget {
    background-color: #0A0E14;
}

QScrollBar:vertical {
    background: #0A0E14;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #5C6675;
    border-radius: 4px;
    min-height: 36px;
}

QScrollBar::handle:vertical:hover {
    background: #9AA4B2;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: #1A212C;
    color: #F2F4F8;
    border: 1px solid #232B38;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 400;
    min-height: 32px;
}

QPushButton:hover,
QPushButton:focus {
    background-color: #161C26;
    border-color: #5C6675;
    color: #F2F4F8;
}

QPushButton:pressed {
    background-color: #0F141C;
    border-color: #9AA4B2;
}

QPushButton:disabled {
    background-color: #0F141C;
    color: #5C6675;
    border-color: #232B38;
}

QPushButton#start_button,
QPushButton#stop_button {
    font-size: 18px;
    font-weight: 700;
    min-height: 48px;
    border-radius: 8px;
}

QPushButton#start_button {
    background-color: #4C8C5B;
    border-color: #3E7249;
    color: #FFFFFF;
}

QPushButton#start_button:hover,
QPushButton#start_button:focus {
    background-color: #3E7249;
    border-color: #4C8C5B;
}

QPushButton#stop_button {
    background-color: #9C4A4A;
    border-color: #7E3A3A;
}

QPushButton#stop_button:hover,
QPushButton#stop_button:focus {
    background-color: #7E3A3A;
    border-color: #9C4A4A;
}

QPushButton#install_driver_button,
QPushButton#strava_authorize_button,
QPushButton#strava_upload_button {
    background-color: #3B82F6;
    border-color: #3B82F6;
    color: #FFFFFF;
}

QPushButton#install_driver_button:hover,
QPushButton#install_driver_button:focus,
QPushButton#strava_authorize_button:hover,
QPushButton#strava_authorize_button:focus,
QPushButton#strava_upload_button:hover,
QPushButton#strava_upload_button:focus {
    background-color: #5B9CF6;
    border-color: #5B9CF6;
}

/* --- NAV PILLS --- */
QPushButton#nav_pill {
    background-color: transparent;
    color: #9AA4B2;
    border: 0;
    border-radius: 22px;
    padding: 10px 22px;
    margin: 0 2px;
    min-height: 24px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.2px;
}

QPushButton#nav_pill:hover,
QPushButton#nav_pill:focus {
    background-color: #161C26;
    color: #F2F4F8;
    outline: 0;
}

QPushButton#nav_pill:checked {
    background-color: rgba(59, 130, 246, 0.16);
    color: #5B9CF6;
}

QPushButton#nav_pill:checked:hover,
QPushButton#nav_pill:checked:focus {
    background-color: rgba(59, 130, 246, 0.24);
}

/* --- INPUTS --- */
QComboBox,
QLineEdit,
QDoubleSpinBox,
QSpinBox {
    background-color: #1A212C;
    color: #F2F4F8;
    border: 1px solid #232B38;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 28px;
    font-weight: 400;
    selection-background-color: #3B82F6;
}

QComboBox:hover,
QLineEdit:hover,
QDoubleSpinBox:hover,
QSpinBox:hover,
QComboBox:focus,
QLineEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus {
    border-color: #3B82F6;
    background-color: #161C26;
}

QComboBox::drop-down {
    border: 0;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1A212C;
    color: #F2F4F8;
    border: 1px solid #232B38;
    selection-background-color: #161C26;
    selection-color: #F2F4F8;
    outline: 0;
}

QFormLayout QLabel {
    color: #9AA4B2;
    font-weight: 400;
}

QCheckBox {
    color: #F2F4F8;
    spacing: 8px;
    font-weight: 400;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #5C6675;
    border-radius: 3px;
    background-color: #1A212C;
}

QCheckBox::indicator:hover {
    border-color: #9AA4B2;
}

QCheckBox::indicator:checked {
    background-color: #F2F4F8;
    border-color: #F2F4F8;
}

/* --- SLIDER --- */
QSlider::groove:horizontal {
    background: #1A212C;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #3B82F6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #F2F4F8;
    border: 2px solid #0A0E14;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #FFFFFF;
}

/* --- PROGRESS BAR --- */
QProgressBar {
    background-color: #0A0E14;
    border: 1px solid #232B38;
    border-radius: 4px;
    color: #F2F4F8;
    font-size: 11px;
    font-weight: 400;
    min-height: 16px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #3B82F6;
    border-radius: 3px;
}

/* --- DIALOG --- */
QMessageBox {
    background-color: #0F141C;
}

QToolTip {
    background-color: #161C26;
    color: #F2F4F8;
    border: 1px solid #5C6675;
    padding: 6px 10px;
    border-radius: 4px;
    font-weight: 400;
}

/* --- PROFILE TILES --- */
QFrame#profile_tile {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-radius: 8px;
    min-height: 128px;
}

QFrame#profile_tile:hover {
    background-color: #161C26;
    border-color: #3B82F6;
}

QFrame#profile_tile QLabel#profile_title {
    color: #F2F4F8;
    font-size: 18px;
    font-weight: 600;
}

/* --- SETTINGS --- */
QFrame#settings_header {
    background-color: transparent;
    border: 0;
}

QLabel#settings_title {
    color: #F2F4F8;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.9px;
}

QFrame#menu_sidebar {
    background-color: #0F141C;
    border: 0;
    border-radius: 0;
    min-width: 260px;
}

QListWidget#menu_list {
    background-color: #0F141C;
    color: #9AA4B2;
    border: 0;
    outline: 0;
    font-size: 16px;
    font-weight: 700;
    icon-size: 24px;
}

QListWidget#menu_list::item {
    background-color: transparent;
    padding: 10px 18px;
    margin: 2px 0;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
    color: #9AA4B2;
    font-size: 16px;
    font-weight: 700;
}

QListWidget#menu_list::item:selected {
    background-color: #161C26;
    border: 1px solid #232B38;
    border-left: 3px solid #3B82F6;
    color: #F2F4F8;
}

QListWidget#menu_list::item:hover:!selected {
    background-color: #161C26;
    border: 1px solid #232B38;
    border-left: 3px solid #232B38;
    color: #F2F4F8;
}

QStackedWidget#menu_stack {
    background-color: transparent;
}

/* --- EMPTY STATE --- */
QFrame#empty_state {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-radius: 8px;
}

QLabel#empty_state_title {
    color: #9AA4B2;
    font-size: 16px;
    font-weight: 600;
}

QLabel#empty_state_body {
    color: #5C6675;
    font-size: 14px;
    font-weight: 400;
}

/* --- ERROR / WARNING CARDS --- */
QFrame#error_card {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-left: 3px solid #B0453F;
    border-radius: 8px;
}

QFrame#warning_card {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-left: 3px solid #C99B3E;
    border-radius: 8px;
}

QLabel#error_card_text {
    color: #B0453F;
    font-size: 14px;
    font-weight: 500;
}

QLabel#warning_card_text {
    color: #C99B3E;
    font-size: 14px;
    font-weight: 500;
}

/* --- TOAST --- */
QFrame#toast {
    background-color: #161C26;
    border: 1px solid #232B38;
    border-radius: 8px;
}

QLabel#toast_label {
    color: #F2F4F8;
    font-size: 13px;
    font-weight: 500;
}

/* --- MODAL --- */
QFrame#modal_card {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-radius: 8px;
}

QLabel#modal_title {
    color: #F2F4F8;
    font-size: 18px;
    font-weight: 700;
}

QLabel#modal_body {
    color: #9AA4B2;
    font-size: 14px;
    font-weight: 400;
}

/* --- SESSION HISTORY ROW --- */
QFrame#session_history_row {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-radius: 6px;
}

QFrame#session_history_row:hover {
    background-color: #161C26;
    border-color: #5C6675;
}

/* --- STATS CHART --- */
QFrame#chart_container {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-radius: 8px;
}

QLabel#chart_toggle_label {
    color: #5C6675;
    font-size: 11px;
    font-weight: 500;
}

QLabel#metric_display {
    color: #F2F4F8;
    font-size: 36px;
    font-weight: 700;
}

QLabel#metric_unit_display {
    color: #9AA4B2;
    font-size: 14px;
    font-weight: 400;
}

/* --- DATA ROW --- */
QFrame#data_row {
    background-color: #0F141C;
    border: 1px solid #232B38;
    border-radius: 6px;
    padding: 12px;
}

QFrame#data_row:hover {
    background-color: #161C26;
}

QLabel#data_row_label {
    color: #9AA4B2;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.8px;
}

QLabel#data_row_value {
    color: #F2F4F8;
    font-size: 15px;
    font-weight: 600;
}